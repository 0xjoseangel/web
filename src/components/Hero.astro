---
import { siteConfig } from "../config";
---

<div
  id="hero"
  class="relative isolate overflow-hidden min-h-screen flex items-center"
  style={`--accent-color: ${siteConfig.accentColor}`}
>
  <!-- Animated gradient orbs -->
  <div class="absolute inset-0 -z-10">
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-[var(--color-accent)] rounded-full opacity-5 blur-[100px] animate-pulse"></div>
    <div class="absolute bottom-1/4 right-1/4 w-80 h-80 bg-purple-500 rounded-full opacity-5 blur-[100px] animate-pulse" style="animation-delay: 1s;"></div>
    <div class="absolute top-1/2 right-1/3 w-64 h-64 bg-blue-500 rounded-full opacity-5 blur-[100px] animate-pulse" style="animation-delay: 2s;"></div>
  </div>

  <!-- Grid pattern -->
  <svg
    aria-hidden="true"
    class="absolute inset-0 -z-10 size-full opacity-20"
  >
    <defs>
      <pattern
        id="grid-pattern"
        width={60}
        height={60}
        patternUnits="userSpaceOnUse"
      >
        <path d="M60 0V60H0" fill="none" stroke="var(--color-border)" stroke-width="0.5"></path>
      </pattern>
    </defs>
    <rect fill="url(#grid-pattern)" width="100%" height="100%" style="mask-image: radial-gradient(ellipse at center, black 30%, transparent 70%);"></rect>
  </svg>

  <div class="w-full mx-auto p-8 sm:p-12 md:p-24">
    <div class="max-w-4xl">
      <!-- Terminal prompt -->
      <div class="animate-fade-in mb-6">
        <span class="font-['JetBrains_Mono'] text-[var(--color-accent)] text-base sm:text-lg">
          <span class="text-[var(--color-text-muted)]">$</span> whoami
        </span>
      </div>

      <h1
        class="text-4xl sm:text-5xl md:text-6xl lg:text-8xl font-bold tracking-tight animate-fade-in animation-delay-200"
      >
        <span class="text-[var(--color-text-primary)]">{siteConfig.name.split(' ')[0]}</span>
        <span class="text-[var(--color-accent)] glow-text"> {siteConfig.name.split(' ').slice(1).join(' ')}</span>
      </h1>

      <div class="mt-6 sm:mt-8 animate-fade-in animation-delay-400">
        <p class="font-['JetBrains_Mono'] text-base sm:text-lg md:text-xl text-[var(--color-text-secondary)]">
          <span class="text-[var(--color-accent)]">&gt;</span> {siteConfig.title}
        </p>
      </div>

      <!-- Social links -->
      <div class="mt-10 sm:mt-12 flex gap-x-5 sm:gap-x-6 animate-fade-in animation-delay-600">
        {
          siteConfig.social?.email && (
            <a
              href={`mailto:${siteConfig.social.email}`}
              aria-label="Email"
              class="text-[var(--color-text-muted)] transition-all duration-300 hover:text-[var(--color-accent)] hover:scale-110"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6 sm:h-7 sm:w-7">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" />
                <path d="M3 7l9 6l9 -6" />
              </svg>
            </a>
          )
        }
        {
          siteConfig.social?.linkedin && (
            <a
              href={siteConfig.social.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn"
              class="text-[var(--color-text-muted)] transition-all duration-300 hover:text-[var(--color-accent)] hover:scale-110"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6 sm:h-7 sm:w-7">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M8 11v5" /><path d="M8 8v.01" /><path d="M12 16v-5" />
                <path d="M16 16v-3a2 2 0 1 0 -4 0" />
                <path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z" />
              </svg>
            </a>
          )
        }
        {
          siteConfig.social?.twitter && (
            <a
              href={siteConfig.social.twitter}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Twitter"
              class="text-[var(--color-text-muted)] transition-all duration-300 hover:text-[var(--color-accent)] hover:scale-110"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6 sm:h-7 sm:w-7">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M4 4l11.733 16h4.267l-11.733 -16z" />
                <path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772" />
              </svg>
            </a>
          )
        }
        {
          siteConfig.social?.github && (
            <a
              href={siteConfig.social.github}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="GitHub"
              class="text-[var(--color-text-muted)] transition-all duration-300 hover:text-[var(--color-accent)] hover:scale-110"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6 sm:h-7 sm:w-7">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" />
              </svg>
            </a>
          )
        }
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-fade-in animation-delay-800">
    <div class="w-6 h-10 border-2 border-[var(--color-border)] rounded-full flex justify-center">
      <div class="w-1 h-3 bg-[var(--color-accent)] rounded-full mt-2 animate-bounce"></div>
    </div>
  </div>
</div>
