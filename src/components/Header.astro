---
import { siteConfig } from "../config";
import { content } from "../content";
import { useTranslations, getAltLangPath, languages, type Lang } from "../i18n/ui";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const t = useTranslations(lang);
const c = content[lang];

const hasProjects = c.projects && c.projects.length > 0;
const hasExperience = c.experience && c.experience.length > 0;
const hasEducation = c.education && c.education.length > 0;
const hasGitHub = siteConfig.github && siteConfig.github.username;

const altLang: Lang = lang === "es" ? "en" : "es";
const altPath = getAltLangPath(lang);
---

<header
  id="header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
>
  <nav class="max-w-7xl mx-auto px-4 sm:px-8 py-4 flex items-center justify-between gap-3 sm:gap-6">
    <a href="#hero" class="text-[var(--color-accent)] font-bold text-lg font-['JetBrains_Mono'] hidden md:block">
      ~/portfolio
    </a>
    <ul class="flex items-center gap-4 sm:gap-6 lg:gap-8 min-w-0 overflow-x-auto whitespace-nowrap [scrollbar-width:none] [&::-webkit-scrollbar]:hidden md:mx-0">
      <li>
        <a
          href="#about"
          class="text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors font-medium text-xs sm:text-sm"
        >
          {t("nav.about")}
        </a>
      </li>
      {
        hasProjects && (
          <li>
            <a
              href="#projects"
              class="text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors font-medium text-xs sm:text-sm"
            >
              {t("nav.projects")}
            </a>
          </li>
        )
      }
      {
        hasGitHub && (
          <li>
            <a
              href="#github"
              class="text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors font-medium text-xs sm:text-sm"
            >
              {t("nav.github")}
            </a>
          </li>
        )
      }
      {
        hasExperience && (
          <li>
            <a
              href="#experience"
              class="text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors font-medium text-xs sm:text-sm"
            >
              {t("nav.experience")}
            </a>
          </li>
        )
      }
      {
        hasEducation && (
          <li>
            <a
              href="#education"
              class="text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors font-medium text-xs sm:text-sm"
            >
              {t("nav.education")}
            </a>
          </li>
        )
      }
    </ul>
    <a
      href={altPath}
      title={t("nav.switchTo")}
      hreflang={altLang}
      class="shrink-0 flex items-center gap-1.5 px-2.5 sm:px-3 py-1.5 border border-[var(--color-border)] rounded-lg text-xs font-semibold text-[var(--color-text-secondary)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-all duration-300 font-['JetBrains_Mono']"
    >
      <svg class="hidden sm:block" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
        <path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0" />
        <path d="M3.6 9h16.8" /><path d="M3.6 15h16.8" />
        <path d="M11.5 3a17 17 0 0 0 0 18" /><path d="M12.5 3a17 17 0 0 1 0 18" />
      </svg>
      {languages[altLang]}
    </a>
  </nav>
</header>

<script>
  window.addEventListener("scroll", () => {
    const header = document.getElementById("header");
    if (window.scrollY > 100) {
      header?.classList.add("bg-[#0a0a0f]/95", "md:bg-[#0a0a0f]/80", "md:backdrop-blur-md", "border-b", "border-[#2a2a3a]/50");
    } else {
      header?.classList.remove("bg-[#0a0a0f]/95", "md:bg-[#0a0a0f]/80", "md:backdrop-blur-md", "border-b", "border-[#2a2a3a]/50");
    }
  });

  // Active section indicator
  const sections = document.querySelectorAll("section[id], div[id='hero']");
  const navLinks = document.querySelectorAll("header a[href^='#']");

  const observerNav = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          navLinks.forEach((link) => {
            link.classList.remove("text-[var(--color-accent)]");
            if (link.getAttribute("href") === `#${id}`) {
              link.classList.add("text-[var(--color-accent)]");
            }
          });
        }
      });
    },
    { threshold: 0.3 }
  );

  sections.forEach((section) => observerNav.observe(section));
</script>
