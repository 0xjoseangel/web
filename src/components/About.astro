---
import { siteConfig } from "../config";
---

<section id="about" class="p-8 sm:p-12 md:p-16 lg:p-24 reveal">
  <div>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
      <div class="lg:col-span-4">
        <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-[var(--color-text-primary)]">
          Sobre Mí
        </h2>
        <div
          class="w-[75px] h-[5px] mt-2 rounded-full"
          style={`background-color: ${siteConfig.accentColor}`}
        ></div>
      </div>

      <div class="lg:col-span-8 space-y-8">
        <!-- Terminal-style box -->
        <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-card)] overflow-hidden">
          <!-- Terminal bar -->
          <div class="flex items-center gap-2 px-4 py-3 border-b border-[var(--color-border)] bg-[var(--color-bg-secondary)]">
            <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
            <span class="ml-3 text-xs text-[var(--color-text-muted)] font-['JetBrains_Mono']">about.md</span>
          </div>
          <!-- Content -->
          <div class="p-6 sm:p-8">
            <p class="text-base sm:text-lg leading-relaxed text-[var(--color-text-secondary)]">
              {siteConfig.aboutMe}
            </p>
          </div>
        </div>

        <div class="pt-2">
          <div class="flex flex-wrap gap-3">
            {
              siteConfig.skills.map((skill) => (
                <span
                  class="px-3 sm:px-4 py-1.5 sm:py-2 bg-[var(--color-bg-card)] text-[var(--color-text-secondary)] border border-[var(--color-border)] rounded-lg text-sm sm:text-base font-medium hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-all duration-300"
                >
                  {skill}
                </span>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
