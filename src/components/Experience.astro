---
import { siteConfig } from "../config";
const hasExperience = (siteConfig as any).experience && (siteConfig as any).experience.length > 0;
---

{
  hasExperience && (
    <section id="experience" class="p-8 sm:p-12 md:p-16 lg:p-24 reveal">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-[var(--color-text-primary)]">
              Experiencia
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>

          <div class="lg:col-span-8">
            <div class="relative">
              {(siteConfig as any).experience.map((exp: any, index: number) => (
                <div class="relative mb-12 last:mb-0">
                  <div
                    class="absolute left-1/2 -top-2 w-4 h-4 border-2 rounded-full -translate-x-1/2 z-20"
                    style={`border-color: ${siteConfig.accentColor}; background-color: ${siteConfig.accentColor}`}
                  />

                  {index < (siteConfig as any).experience.length - 1 && (
                    <div class="absolute left-1/2 bottom-0 w-0.5 h-12 bg-[var(--color-border)] -translate-x-1/2 translate-y-full z-10" />
                  )}

                  <div class="bg-[var(--color-bg-card)] rounded-xl border border-[var(--color-border)] p-4 sm:p-5 md:p-6 hover:border-[var(--color-accent)]/30 transition-all duration-300">
                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-4">
                      <div>
                        <h3 class="text-lg sm:text-xl font-semibold text-[var(--color-text-primary)]">
                          {exp.title}
                        </h3>
                        <p style={`color: ${siteConfig.accentColor}`}>
                          {exp.company}
                        </p>
                      </div>
                      <span class="text-xs sm:text-sm text-[var(--color-text-muted)] mt-2 sm:mt-0 font-['JetBrains_Mono']">
                        {exp.dateRange}
                      </span>
                    </div>

                    <ul class="space-y-2">
                      {exp.bullets.map((bullet: string) => (
                        <li class="flex items-start">
                          <span class="inline-block w-1.5 h-1.5 rounded-full mt-2 mr-3 flex-shrink-0" style={`background-color: ${siteConfig.accentColor}`} />
                          <span class="text-sm sm:text-base text-[var(--color-text-secondary)]">
                            {bullet}
                          </span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
